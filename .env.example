# ============================================================
#  UNISMUH CodeUnical — contoh environment
#  Salin ke .env lalu isi. JANGAN commit .env (sudah di-gitignore).
#  Nilai __GANTI__ wajib diganti dengan rahasia acak yang kuat.
# ============================================================

# ── App ──
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:47080

# ── Port (blok 47xxx — mandiri, tidak bentrok proyek lain) ──
WEB_PORT=47300
API_PORT=47080

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=47432
POSTGRES_DB=codeunical
POSTGRES_USER=codeunical
POSTGRES_PASSWORD=__GANTI__
DATABASE_URL=postgresql://codeunical:__GANTI__@localhost:47432/codeunical

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=47379
REDIS_PASSWORD=__GANTI__

# ── MinIO (bukti kamera / artefak) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=47900
MINIO_CONSOLE_PORT=47901
MINIO_ROOT_USER=codeunical
MINIO_ROOT_PASSWORD=__GANTI__
MINIO_BUCKET=codeunical-evidence

# ── Auth ──
JWT_SECRET=__GANTI_ACAK__
SESSION_SECRET=__GANTI_ACAK__

# ── Sandbox eksekusi ──
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_MB=512

# ── Proctor/ML (fase akhir, opsional) ──
PROCTOR_URL=http://localhost:47500

# ── Retensi bukti kamera (hari) ──
EVIDENCE_RETENTION_DAYS=30
