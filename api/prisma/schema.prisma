generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Problem {
  id          String       @id @default(cuid())
  title       String
  description String
  language    String       @default("python")
  starterCode String       @default("")
  setupSql    String?      // untuk soal SQL: DDL + seed (ditampilkan ke peserta)
  difficulty  String       @default("mudah") // mudah | sedang | sulit
  timeLimitMs Int          @default(15000)
  createdAt   DateTime     @default(now())
  testCases   TestCase[]
  submissions Submission[]
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  stdin     String  @default("")
  expected  String
  hidden    Boolean @default(true)
  points    Int     @default(1)
  order     Int     @default(0)
}

model Submission {
  id        String   @id @default(cuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  code      String
  language  String   @default("python")
  passed    Int      @default(0)
  total     Int      @default(0)
  score     Int      @default(0)
  maxScore  Int      @default(0)
  detail    Json?
  createdAt DateTime @default(now())
}

model ExamAttempt {
  id         String         @id @default(cuid())
  problemId  String?
  status     String         @default("active") // active | kicked | finished
  strikes    Int            @default(0)
  startedAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())
  endedAt    DateTime?
  events     ProctorEvent[]
  keystrokes Keystroke[]
  snapshots  ProctorSnapshot[]
}

model ProctorEvent {
  id        String      @id @default(cuid())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  kind      String
  at        DateTime    @default(now())
  meta      Json?

  @@index([attemptId])
}

model Keystroke {
  id        String      @id @default(cuid())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  t         Int // ms offset dari mulai attempt
  value     String

  @@index([attemptId])
}

model ProctorSnapshot {
  id        String      @id @default(cuid())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  kind      String
  mime      String      @default("image/jpeg")
  image     Bytes?      // dipakai bila MinIO nonaktif (fallback DB)
  objectKey String?     // kunci objek MinIO bila aktif
  at        DateTime    @default(now())

  @@index([attemptId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("peserta") // superadmin | penguji | peserta
  status       String    @default("active") // active | pending | suspended
  passwordHash String?
  ssoSub       String?   @unique
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
